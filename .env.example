PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/admission_automation
JWT_SECRET=change_this_to_a_long_random_secret_in_production
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173

# Nodemailer SMTP
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="AdmissionPortal <noreply@admissionportal.edu>"

# Razorpay Test Mode
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Storage
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=5

